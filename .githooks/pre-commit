#!/usr/bin/env bash
# Git pre-commit hook enforcing .clang-format on staged C++ files
set -e

CLANG_FORMAT=$(which clang-format 2>/dev/null || true)
if [ -z "$CLANG_FORMAT" ]; then
    echo "⚠️  clang-format not found in PATH; skipping pre-commit formatting check."
    exit 0
fi

# Find staged C++ files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|hpp|c|h)$' || true)

if [ -n "$STAGED_FILES" ]; then
    echo "🔍 Checking C++ formatting with clang-format..."
    UNFORMATTED=0
    for FILE in $STAGED_FILES; do
        if [ -f "$FILE" ]; then
            if ! "$CLANG_FORMAT" --dry-run --Werror "$FILE" >/dev/null 2>&1; then
                echo "❌ Formatting violation in: $FILE"
                UNFORMATTED=1
            fi
        fi
    done

    if [ "$UNFORMATTED" -ne 0 ]; then
        echo ""
        echo "🚨 Pre-commit check failed! Staged files do not match .clang-format."
        echo "💡 Run: clang-format -i $STAGED_FILES"
        echo "   Then stage the changes: git add $STAGED_FILES"
        exit 1
    fi
    echo "✅ Formatting verified."
fi

exit 0
